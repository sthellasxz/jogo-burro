{
  "name": "jogo-burro",
  "private": true,
  "version": "1.0.0",
  "description": "Jogo de cartas Burro multiplayer via Bluetooth (Vue 3 + Ionic + Capacitor)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "android": "npm run build && npx cap sync android && npx cap open android"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@ionic/vue": "^9.0.5",
    "@ionic/vue-router": "^9.0.5",
    "ionicons": "^8.0.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.43",
    "vue-router": "^4.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.11"
  }
}
